{% set t = translations[lang] %}
<nav class="navbar navbar-expand-lg navbar-light" id="mainNav">
	<div class="container px-4 px-lg-5">
		<a class="navbar-brand" href="{{ '/' | locale_url }}">
			{{metadata.nav_title}}
		</a>
		<button class="navbar-toggler"
			type="button"
			data-bs-toggle="collapse"
			data-bs-target="#navbarResponsive"
			aria-controls="navbarResponsive"
			aria-expanded="false"
			aria-label="{{ t.menu }}">
			{{ t.menu }} <i class="fas fa-bars"></i>
		</button>
		<div class="collapse navbar-collapse" id="navbarResponsive">
			<ul class="navbar-nav ms-auto py-4 py-lg-0">
				{% for n in metadata.navbar %}
				<li class="nav-item">
					<a class="nav-link px-lg-3 py-3 py-lg-4" href="{{ n.link | locale_url }}">
						{{ t.nav[n.key] }}
					</a>
				</li>
				{% endfor %}
				<li class="nav-item">
					<span class="nav-link px-lg-3 py-3 py-lg-4 language-switcher"
						aria-label="{{ t.languageSwitcher }}">
						{% for link in page.url | locale_links | includeCurrentLocale(lang) | sort(false, false, 'lang') %}
						{% if not loop.first %}<span aria-hidden="true">·</span>{% endif %}
						{% if link.lang == lang %}
						<span aria-current="page" title="{{ t.languageName }}">
							{{ link.lang | upper }}
						</span>
						{% else %}
						<a href="{{ link.url }}"
							lang="{{ link.lang }}"
							hreflang="{{ link.lang }}"
							title="{{ link.label }}">
							{{ link.lang | upper }}
						</a>
						{% endif %}
						{% endfor %}
					</span>
				</li>
			</ul>
		</div>
	</div>
</nav>
