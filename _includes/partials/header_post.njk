{% set t = translations[lang] %}
<header class="masthead" style="background-image: url('{{ image or metadata.image }}')">
<div class="container position-relative px-4 px-lg-5">
<div class="row gx-4 gx-lg-5 justify-content-center">
<div class="col-md-10 col-lg-8 col-xl-7">
<div class="post-heading">
<h1><strong><a href="{{ '/' | locale_url }}" class="text-white">{{title or metadata.title}}</a></strong></h1>
<span class="subheading">{{ description or t.siteDescription }}</span>
<span class="meta">
{{ t.post.by }} <a href="{{ metadata.author.url | locale_url }}" class="text-white">{{metadata.author.name}}</a>
{% if page.date %}{{ t.post.on }} <time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate(lang) }}</time><br/>{% endif %}
{% if tags %}<br/>{%- for tag in tags | filterTagList %}{%- set tagUrl %}/{{ lang }}/tags/{{ tag | slugify }}/{% endset %}
<a href="{{ tagUrl }}" class="text-white">{{ tag }}</a>{%- if not loop.last %}, {% endif %}{%- endfor %}{% endif %}
</span>
</div>
</div>
</div>
</div>
</header>
